# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитим.

APP_ENV=local
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=10s

POSTGRES_DB=careernav
POSTGRES_USER=careernav
POSTGRES_PASSWORD=careernav
POSTGRES_PORT=5432
API_PORT=8080

# Для запуска api/worker без Docker (go run ./cmd/api). В Compose переопределяется на хост db.
DATABASE_URL=postgres://careernav:careernav@localhost:5432/careernav?sslmode=disable

# Адрес сайта для ссылок в письмах (подтверждение почты, сброс пароля)
PUBLIC_URL=http://localhost:3000

# Ключ SuperJob API (https://api.superjob.ru) — нужен только сервису collector
SUPERJOB_API_KEY=

# Расписание сбора вакансий (cron, МСК). По умолчанию — 1-го числа каждого месяца в 03:00
# COLLECT_CRON=0 3 1 * *
